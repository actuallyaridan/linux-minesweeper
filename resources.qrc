        <file alias="blueSheet.png">assets/images/blueSheet.png</file>
        <file alias="greenSheet.png">assets/images/greenSheet.png</file>
        <file alias="otherSheet.png">assets/images/otherSheet.png</file>
        <file alias="flowerGardenSheet.png">assets/images/flowerGardenSheet.png</file>
        <file alias="minesweeperSheet.png">assets/images/minesweeperSheet.png</file>
        <file alias="thumbBlue.png">assets/images/thumbBlue.png</file>
        <file alias="thumbGreen.png">assets/images/thumbGreen.png</file>
        <file alias="thumbMines.png">assets/images/thumbMines.png</file>
        <file alias="thumbFlowers.png">assets/images/thumbFlowers.png</file>
        <file alias="helpBoard.png">assets/images/helpBoard.png</file>
        <file alias="gameStart.wav">assets/audio/gameStart.wav</file>
        <file alias="tileSingle.wav">assets/audio/tileSingle.wav</file>
        <file alias="tileMultiple.wav">assets/audio/tileMultiple.wav</file>
        <file alias="gameWin.wav">assets/audio/gameWin.wav</file>
